{
  "entity": {
    "sensor": {
      "active_season": {
        "default": "mdi:calendar-range"
      },
      "scheduled_temperature": {
        "default": "mdi:thermometer-auto"
      }
    },
    "switch": {
      "smart_schedule": {
        "default": "mdi:calendar-clock",
        "state": {
          "off": "mdi:calendar-remove"
        }
      },
      "away": {
        "default": "mdi:home",
        "state": {
          "on": "mdi:home-export-outline"
        }
      }
    }
  },
  "services": {
    "resume_schedule": {
      "service": "mdi:calendar-sync"
    },
    "get_schedule": {
      "service": "mdi:calendar-search"
    },
    "set_schedule": {
      "service": "mdi:calendar-edit"
    }
  }
}
